{
  "name": "schelm-node-http-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "assemble": "node scripts/assemble-kernels.cjs",
    "check:assembly": "node scripts/assemble-kernels.cjs --check",
    "build": "node scripts/build-fixtures.cjs",
    "test:model": "node --test tests/model/*.test.cjs",
    "test:node": "node --test --test-timeout=60000 tests/node/*.test.cjs",
    "test:workers": "node tests/run-workers.cjs",
    "test:perf": "node tests/perf/scale.test.cjs",
    "test:artifact": "node tests/artifact-gate.cjs",
    "test:archive": "node tests/archive-repro.cjs",
    "test:provenance": "node tests/provenance-gate.cjs",
    "test": "npm run check:assembly && npm run build && npm run test:model && npm run test:node && npm run test:workers && npm run test:perf && npm run test:artifact && npm run test:archive && npm run test:provenance"
  }
}
